{
  "manifest_version": 3,
  "name": "Lucy Browser Bridge",
  "description": "Send the current page to the local Lucy desktop app for private, on-device AI assistance.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Send page to Lucy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
